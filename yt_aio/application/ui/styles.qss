QWidget {
    background: #12161c;
    color: #edf2f7;
    font-family: "fonts-dejavu-core";
    font-size: 13px;
}

QMainWindow {
    background: #0d1117;
}

QGroupBox {
    border: 1px solid #2c3440;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 12px;
    background: #171c24;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #9ecbff;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QTableWidget {
    background: #0f141b;
    border: 1px solid #2c3440;
    border-radius: 8px;
    selection-background-color: #2e5b88;
    selection-color: #ffffff;
}

QHeaderView::section {
    background: #1e2630;
    color: #dce7f2;
    border: none;
    padding: 8px;
    font-weight: 600;
}

QTableWidget {
    gridline-color: #26303b;
    alternate-background-color: #141b23;
}

QPushButton {
    background: #1f6feb;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    color: white;
    font-weight: 600;
}

QPushButton:hover {
    background: #2f81f7;
}

QPushButton:disabled {
    background: #334155;
    color: #a0aec0;
}

QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QRadioButton::indicator::unchecked {
    border: 2px solid #64748b;
    border-radius: 7px;
    background: #0f141b;
}

QRadioButton::indicator::checked {
    border: 2px solid #9ecbff;
    border-radius: 7px;
    background: #2f81f7;
}

QScrollBar:vertical {
    background: #11161d;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 24px;
    border-radius: 6px;
}

QProgressBar {
    border: 1px solid #2c3440;
    border-radius: 8px;
    background: #0f141b;
}

QProgressBar::chunk {
    background: #2f81f7;
    border-radius: 8px;
}

QTabWidget::pane {
    background: #12161c;
    border: 1px solid #2c3440;
    border-radius: 10px;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: #1a2029;
    color: #9fb0c3;
    border: 1px solid #2c3440;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin-right: 4px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #232c38;
    color: #dce7f2;
}

QTabBar::tab:selected {
    background: #12161c;
    color: #edf2f7;
    border-color: #2c3440;
    border-bottom: 2px solid #1f6feb;
}

QComboBox {
    background: #0f141b;
    color: #edf2f7;
    border: 1px solid #2c3440;
    border-radius: 8px;
    padding: 6px 10px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #3a4757;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: #0f141b;
    color: #edf2f7;
    border: 1px solid #2c3440;
    selection-background-color: #2e5b88;
    selection-color: #ffffff;
    outline: none;
}

QSpinBox {
    background: #0f141b;
    color: #edf2f7;
    border: 1px solid #2c3440;
    border-radius: 8px;
    padding: 5px 6px;
    min-width: 70px;
}

QCheckBox {
    spacing: 8px;
    padding: 2px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a4757;
    border-radius: 4px;
    background: #0f141b;
}

QCheckBox::indicator:checked {
    background: #1f6feb;
    border-color: #1f6feb;
}

QScrollArea {
    border: none;
}

QSplitter::handle {
    background: #1e2630;
}

QLabel[role="muted"] {
    color: #9fb0c3;
}
