QWidget {
    background: @surface@;
    color: @text@;
    font-size: @font_size@;
}

QMainWindow {
    background: @window_bg@;
}

QGroupBox {
    border: 1px solid @border@;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 12px;
    background: @surface_raised@;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: @accent_soft@;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QTableWidget {
    background: @field_bg@;
    border: 1px solid @border@;
    border-radius: 8px;
    selection-background-color: @selection_bg@;
    selection-color: @selection_fg@;
}

QHeaderView::section {
    background: @header_bg@;
    color: @text_header@;
    border: none;
    padding: 8px;
    font-weight: 600;
}

QTableWidget {
    gridline-color: @grid@;
    alternate-background-color: @alt_row@;
}

QPushButton {
    background: @accent@;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    color: @on_accent@;
    font-weight: 600;
}

QPushButton:hover {
    background: @accent_hover@;
}

QPushButton:disabled {
    background: @muted_fill@;
    color: @disabled_fg@;
}

QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QRadioButton::indicator::unchecked {
    border: 2px solid @radio_border@;
    border-radius: 7px;
    background: @field_bg@;
}

QRadioButton::indicator::checked {
    border: 2px solid @accent_soft@;
    border-radius: 7px;
    background: @accent_hover@;
}

QScrollBar:vertical {
    background: @scrollbar_bg@;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: @muted_fill@;
    min-height: 24px;
    border-radius: 6px;
}

QProgressBar {
    border: 1px solid @border@;
    border-radius: 8px;
    background: @field_bg@;
}

QProgressBar::chunk {
    background: @accent_hover@;
    border-radius: 8px;
}

QTabWidget::pane {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: @tab_bg@;
    color: @text_dim@;
    border: 1px solid @border@;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin-right: 4px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: @tab_hover@;
    color: @text_header@;
}

QTabBar::tab:selected {
    background: @surface@;
    color: @text@;
    border-color: @border@;
    border-bottom: 2px solid @accent@;
}

QComboBox {
    background: @field_bg@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 6px 10px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: @border_hover@;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: @field_bg@;
    color: @text@;
    border: 1px solid @border@;
    selection-background-color: @selection_bg@;
    selection-color: @selection_fg@;
    outline: none;
}

QSpinBox {
    background: @field_bg@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 5px 6px;
    min-width: 70px;
}

QCheckBox {
    spacing: 8px;
    padding: 2px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @border_hover@;
    border-radius: 4px;
    background: @field_bg@;
}

QCheckBox::indicator:checked {
    background: @accent@;
    border-color: @accent@;
}

QScrollArea {
    border: none;
}

QSplitter::handle {
    background: @header_bg@;
}

QLabel[role="muted"] {
    color: @text_dim@;
}
